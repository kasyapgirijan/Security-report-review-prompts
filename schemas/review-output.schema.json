{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kasyapgirijan/Security-report-review-prompts/schemas/review-output.schema.json",
  "title": "Security Report Review Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "prompt", "run", "standards_versions", "coverage", "findings", "report_blockers", "verdict", "mandatory_actions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "domain", "level"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
        "domain": {"enum": ["appsec", "nwpt", "mobile", "shared"]},
        "level": {"enum": ["analyst", "senior", "principal", "focused"]}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "model_provider", "model_id", "model_version", "executed_at", "temperature", "tool_access"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "model_provider": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "model_version": {"type": "string", "minLength": 1},
        "executed_at": {"type": "string", "format": "date-time"},
        "temperature": {"type": "number", "minimum": 0},
        "tool_access": {"type": "boolean"}
      }
    },
    "standards_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "verification_status"],
        "properties": {
          "version": {"type": ["string", "null"]},
          "verification_status": {"enum": ["verified", "unverified", "not_supplied"]}
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_finding_ids", "reviewed_finding_ids", "unreadable_finding_ids", "truncated", "complete", "limitations"],
      "properties": {
        "expected_finding_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "reviewed_finding_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "unreadable_finding_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "truncated": {"type": "boolean"},
        "complete": {"type": "boolean"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "report_blockers": {"type": "array", "items": {"$ref": "#/$defs/reviewIssue"}},
    "verdict": {
      "enum": ["APPROVE", "APPROVE_WITH_MANDATORY_CHANGES", "REJECT", "CANNOT_APPROVE_INCOMPLETE_REVIEW_COVERAGE"]
    },
    "mandatory_actions": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "evidenceStatus": {"enum": ["confirmed", "supported_inference", "unverified", "contradicted", "not_reviewable"]},
    "confidence": {"enum": ["high", "medium", "low", "not_applicable"]},
    "evidenceLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "locator"],
      "properties": {
        "type": {"enum": ["page", "section", "finding", "figure", "screenshot", "request", "response", "command", "code", "artifact"]},
        "locator": {"type": "string", "minLength": 1},
        "content_hash": {"type": ["string", "null"]}
      }
    },
    "reviewIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue_id", "priority", "category", "description", "evidence_status", "evidence_locators", "required_correction", "acceptance_criterion"],
      "properties": {
        "issue_id": {"type": "string", "minLength": 1},
        "priority": {"enum": ["blocker", "high", "medium", "low"]},
        "category": {"enum": ["coverage", "title", "classification", "evidence", "reproduction", "exploitability", "severity", "impact", "remediation", "reference", "writing", "privacy", "consistency"]},
        "description": {"type": "string", "minLength": 1},
        "evidence_status": {"$ref": "#/$defs/evidenceStatus"},
        "evidence_locators": {"type": "array", "items": {"$ref": "#/$defs/evidenceLocator"}},
        "required_correction": {"type": "string", "minLength": 1},
        "acceptance_criterion": {"type": ["string", "null"]}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "original_title", "proposed_title", "disposition", "evidence_status", "confidence", "evidence_locators", "attacker_model", "impact", "cvss_review", "remediation", "review_issues", "eligible_for_report_approval"],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "original_title": {"type": "string", "minLength": 1},
        "proposed_title": {"type": ["string", "null"]},
        "disposition": {"enum": ["accept", "accept_with_edits", "re_rate", "merge", "split", "downgrade", "withdraw", "not_reviewable"]},
        "evidence_status": {"$ref": "#/$defs/evidenceStatus"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "evidence_locators": {"type": "array", "items": {"$ref": "#/$defs/evidenceLocator"}},
        "attacker_model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["position", "authentication", "privileges", "user_interaction", "preconditions"],
          "properties": {
            "position": {"type": ["string", "null"]},
            "authentication": {"type": ["string", "null"]},
            "privileges": {"type": ["string", "null"]},
            "user_interaction": {"type": ["string", "null"]},
            "preconditions": {"type": "array", "items": {"type": "string"}}
          }
        },
        "impact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["demonstrated", "credible_extension", "speculation_to_remove", "scale", "limiting_controls"],
          "properties": {
            "demonstrated": {"type": "array", "items": {"type": "string"}},
            "credible_extension": {"type": "array", "items": {"type": "string"}},
            "speculation_to_remove": {"type": "array", "items": {"type": "string"}},
            "scale": {"type": ["string", "null"]},
            "limiting_controls": {"type": "array", "items": {"type": "string"}}
          }
        },
        "cvss_review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "version", "original_vector", "proposed_vector", "changed_metrics", "unknown_or_environment_dependent_metrics"],
          "properties": {
            "status": {"enum": ["not_used", "accepted", "disputed", "recalculated", "insufficient_context"]},
            "version": {"type": ["string", "null"]},
            "original_vector": {"type": ["string", "null"]},
            "proposed_vector": {"type": ["string", "null"]},
            "changed_metrics": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["metric", "from", "to", "evidence_locators"],
                "properties": {
                  "metric": {"type": "string"},
                  "from": {"type": ["string", "null"]},
                  "to": {"type": ["string", "null"]},
                  "evidence_locators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceLocator"}}
                }
              }
            },
            "unknown_or_environment_dependent_metrics": {"type": "array", "items": {"type": "string"}}
          }
        },
        "remediation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary_fix", "enforcement_layer", "temporary_mitigation", "defence_in_depth", "rollout_and_migration", "verification_tests", "closure_criteria"],
          "properties": {
            "primary_fix": {"type": ["string", "null"]},
            "enforcement_layer": {"type": ["string", "null"]},
            "temporary_mitigation": {"type": ["string", "null"]},
            "defence_in_depth": {"type": "array", "items": {"type": "string"}},
            "rollout_and_migration": {"type": "array", "items": {"type": "string"}},
            "verification_tests": {"type": "array", "items": {"type": "string"}},
            "closure_criteria": {"type": "array", "items": {"type": "string"}}
          }
        },
        "review_issues": {"type": "array", "items": {"$ref": "#/$defs/reviewIssue"}},
        "eligible_for_report_approval": {"type": "boolean"}
      }
    }
  }
}
